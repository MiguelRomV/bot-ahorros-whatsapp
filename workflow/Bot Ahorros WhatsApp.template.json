      "parameters": {
        "jsCode": "let totalAhorros = 0;\nlet totalRetiros = 0;\n\nfor (const item of items) {\n  const tipo = item.json.property_tipo;\n  const cantidad = Number(item.json.property_cantidad || 0);\n\n  if (tipo === \"Ahorro\") {\n    totalAhorros += cantidad;\n  }\n\n  if (tipo === \"Retiro\") {\n    totalRetiros += cantidad;\n  }\n}\n\nconst saldo = totalAhorros - totalRetiros;\n\nreturn [\n  {\n    json: {\n      totalAhorros,\n      totalRetiros,\n      saldo\n    }\n  }\n];"
