    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Obtener mensaje original de WhatsApp\nconst mensajeOriginal = $json.body.payload.body\n  .toLowerCase()\n  .trim();\n\n// Ignorar mensajes generados por el propio bot\nif (\n  mensajeOriginal.startsWith(\"✅\") ||\n  mensajeOriginal.startsWith(\"💸\") ||\n  mensajeOriginal.startsWith(\"💰\")\n) {\n  return {\n    valido: false,\n    mensajeOriginal,\n    ignorado: true,\n    motivo: \"Respuesta automática del bot\"\n  };\n}\n\n// Quitar el prefijo que usamos para identificar\n// nuestros mensajes de prueba\nconst mensaje = mensajeOriginal\n  .replace(/^ahorro_test_\\d+\\s*/i, \"\")\n  .trim();\n\n// Buscar la cantidad\nconst coincidencia = mensaje.match(\n  /(?:\\$?\\s*)(\\d+(?:[.,]\\d{1,2})?)/\n);\n\nif (!coincidencia) {\n  return {\n    valido: false,\n    mensajeOriginal,\n    error: \"No encontré una cantidad\"\n  };\n}\n\nconst cantidad = parseFloat(\n  coincidencia[1].replace(\",\", \".\")\n);\n\n// Palabras que indican AHORRO\nconst palabrasAhorro = [\n  \"ahorre\",\n  \"ahorré\",\n  \"ahorro\",\n  \"guarde\",\n  \"guardé\",\n  \"aparte\",\n  \"aparté\",\n  \"meti\",\n  \"metí\",\n  \"deposite\",\n  \"deposité\"\n];\n\n// Palabras que indican RETIRO\nconst palabrasRetiro = [\n  \"retire\",\n  \"retiré\",\n  \"retiro\",\n  \"tome\",\n  \"tomé\",\n  \"saque\",\n  \"saqué\",\n  \"quite\",\n  \"quité\"\n];\n\nlet tipo = null;\n\nif (palabrasAhorro.some(palabra => mensaje.includes(palabra))) {\n  tipo = \"Ahorro\";\n}\n\nif (palabrasRetiro.some(palabra => mensaje.includes(palabra))) {\n  tipo = \"Retiro\";\n}\n\nif (!tipo) {\n  return {\n    valido: false,\n    mensajeOriginal,\n    cantidad,\n    error: \"No pude determinar si es ahorro o retiro\"\n  };\n}\n\n// Crear concepto automáticamente\nlet concepto = mensaje;\n\n// Quitar la cantidad\nconcepto = concepto.replace(\n  /\\$?\\s*\\d+(?:[.,]\\d{1,2})?/,\n  \"\"\n);\n\n// Quitar palabras comunes\nconst palabrasEliminar = [\n  \"ahorre\",\n  \"ahorré\",\n  \"ahorro\",\n  \"guarde\",\n  \"guardé\",\n  \"aparte\",\n  \"aparté\",\n  \"meti\",\n  \"metí\",\n  \"deposite\",\n  \"deposité\",\n  \"retire\",\n  \"retiré\",\n  \"retiro\",\n  \"tome\",\n  \"tomé\",\n  \"saque\",\n  \"saqué\",\n  \"quite\",\n  \"quité\",\n  \"pesos\",\n  \"peso\",\n  \"de mis ahorros\",\n  \"del ahorro\",\n  \"para\",\n  \"en\"\n];\n\nfor (const palabra of palabrasEliminar) {\n  concepto = concepto.replace(\n    new RegExp(`\\\\b${palabra}\\\\b`, \"gi\"),\n    \"\"\n  );\n}\n\nconcepto = concepto\n  .replace(/\\s+/g, \" \")\n  .trim();\n\n// Si no quedó concepto, usar el tipo\nif (!concepto) {\n  concepto = tipo;\n}\n\n// Primera letra mayúscula\nconcepto =\n  concepto.charAt(0).toUpperCase() +\n  concepto.slice(1);\n\nreturn {\n  valido: true,\n  tipo,\n  cantidad,\n  concepto,\n  mensajeOriginal,\n  fecha: new Date().toISOString()\n};"
      },
